## Para mostrar tabelas com valores com vírgula em decimal e separador de milhares

scales::number(
  dados_orc_sp_2003_2025$Vl_Liquidado,
  accuracy = 0.01,
  decimal.mark = ",",
  big.mark = "."
)

ou 
tabela %>%
  mutate(
    across(
      where(is.numeric),
      ~ scales::number(
          .x,
          accuracy = 0.01,
          decimal.mark = ",",
          big.mark = "."
        )
    )
  ) %>%
  knitr::kable()
  
