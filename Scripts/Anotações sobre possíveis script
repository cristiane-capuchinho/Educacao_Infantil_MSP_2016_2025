# ------------------------------------------------------------
# Explorar a classificação dos ProjetoAtividade
# ------------------------------------------------------------
exploracao_projetos <- dadosfunedu_16_25 %>%
  
  # Seleciona apenas os códigos de interesse
  filter(
    ProjetoAtividade %in% projetos_explorar$ProjetoAtividade
  ) %>%
  
  # Mantém apenas registros com classificação
  filter(
    !is.na(Ds_SubFuncao),
    Ds_SubFuncao != ""
  ) %>%
  
  # Agrupa pelo código, descrição existente no banco,
  # subfunção e ano
  group_by(
    ProjetoAtividade,
    Ds_Projeto_Atividade,
    Ds_SubFuncao
  ) %>%
  
  summarise(
    Anos = paste(
      sort(unique(Cd_Exercicio)),
      collapse = ", "
    ),
    .groups = "drop"
  ) %>%
  
  arrange(
    ProjetoAtividade,
    Ds_Projeto_Atividade,
    Ds_SubFuncao
  )

exploracao_projetos


